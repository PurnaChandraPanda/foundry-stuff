# Foundry project endpoint
PROJECT_ENDPOINT="https://{foundry-account}.services.ai.azure.com/api/projects/{foundry-project}"

# Foundry agent name
AGENT_NAME={foundry-agent-name}
# Foundry agent protocol, either "responses" or "invocations"
AGENT_PROTOCOL=invocations
# Foundry agent API version - keep as v1
AGENT_API_VERSION="v1"

# Concurrency and requests per session
CONCURRENCY=1
REQUESTS_PER_SESSION=1

# Existing foundry agent session ID - make sure do one request for it, warm it up. Then, use it for subsequent requests.
AGENT_SESSION_ID=38-----------------------------------------------0b

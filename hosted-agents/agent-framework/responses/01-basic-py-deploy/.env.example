# Foundry project endpoint
FOUNDRY_PROJECT_ENDPOINT="https://{xxxxxxx}.services.ai.azure.com/api/projects/{xxxxxxx}"
# Hosted agent name
AGENT_NAME=agent-framework-pydeploy-agent-basic-responses
# Source directory with source directory
AGENT_SOURCE_DIR=src/agent-framework-agent-basic-responses
# Agent CPU allocation (number of CPU cores)
AGENT_CPU=0.5
# Agent memory allocation (e.g., 1Gi, 2Gi)
AGENT_MEMORY=1Gi
# Agent runtime environment
AGENT_RUNTIME=python_3_13
# Agent protocol configuration
AGENT_PROTOCOL=responses
# Agent protocol version
AGENT_PROTOCOL_VERSION=2.0.0
# Agent entry point (command to start the agent)
AGENT_ENTRY_POINT='["python", "main.py"]'
# Agent deployment timeout in seconds
AGENT_DEPLOY_TIMEOUT_SECONDS=600
# Agent poll interval in seconds
AGENT_POLL_INTERVAL_SECONDS=5

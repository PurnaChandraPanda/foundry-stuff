# Tenant of the subscription containing the Foundry resource.
AZURE_TENANT_ID=""

# Full project ARM resource ID for the on-demand connection script, not the endpoint.
AZURE_AI_PROJECT_ID="/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>"
AZURE_AI_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="<model-deployment-name>"

# Public APIM endpoint. Needed for toolbox creation, not for consumption.
APIM_MCP_URL="https://<public-apim-host>/<api-suffix>/mcp"
APIM_MCP_SERVER_LABEL="public-apim"
APIM_MCP_CONNECTION_NAME="public-apim-mcp"
APIM_ALLOWED_TOOLS=""

# Used only by ../create_mcp_connection.sh toolbox-mcp, not by agent consumers.
APIM_SUBSCRIPTION_KEY_HEADER="Ocp-Apim-Subscription-Key"
APIM_SUBSCRIPTION_KEY=""

APIM_TOOLBOX_NAME="public-apim-toolbox"
APIM_TOOLBOX_VERSION=""
MCP_TIMEOUT_SECONDS="120"

# Prompt agent -> toolbox: a separate Entra-authenticated RemoteTool connection.
# Do not use APIM_MCP_CONNECTION_NAME (that connection targets downstream APIM).
APIM_TOOLBOX_CONNECTION_NAME="public-apim-toolbox-mcp"
APIM_PROMPT_AGENT_NAME="public-apim-toolbox-prompt"

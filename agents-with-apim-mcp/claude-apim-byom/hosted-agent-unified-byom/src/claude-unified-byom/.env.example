
# Foundry project id
FOUNDRY_PROJECT_ID="/subscriptions/{sub-id}/resourceGroups/{your-resource-group}/providers/Microsoft.CognitiveServices/accounts/{foundry-account}/projects/{foundry-project}"

# Project endpoint for the AI Project
FOUNDRY_PROJECT_ENDPOINT="https://{foundry-account}.services.ai.azure.com/api/projects/{foundry-project}"

# BYOM model name as foundry admin connected model
BYOM_MODEL="{APIM_API_NAME}/{MODEL_NAME}"


# Foundry Anthropic endpoint
FOUNDRY_ANTHROPIC_ENDPOINT="https://{foundry-account}.services.ai.azure.com/anthropic"

# Foundry Anthropic model deployment, e.g. claude-sonnet-4-6
FOUNDRY_ANTHROPIC_DEPLOYMENT="claude-sonnet-4-6"

# APIM API Foundry Anthropic endpoint and deployment
APIM_API_FOUNDRY_ANTHROPIC_ENDPOINT="https://{APIM-NAME}.azure-api.net/{APIM-API-NAME}/anthropic"
# Foundry Anthropic model deployment, e.g. claude-sonnet-4-6
APIM_API_FOUNDRY_ANTHROPIC_DEPLOYMENT="claude-opus-5"

# APIM Unified API base URL (extension - e.g. /llm/v1) and model alias (e.g. claude-byom)
APIM_UNIFIED_API_BASE_URL="https://{APIM-NAME}.azure-api.net/{extension}"
APIM_UNIFIED_API_MODEL_ALIAS="claude-byom"

# Project endpoint for the AI Project
FOUNDRY_PROJECT_ENDPOINT="https://{foundry-account}.services.ai.azure.com/api/projects/{foundry-project}"

# BYOM model name as foundry admin connected model
BYOM_MODEL="{APIM_UNIFIED_API_NAME}/{MODEL_NAME}"

# Foundry prompt agent name
PROMPT_AGENT_NAME="byom-claude-agent"


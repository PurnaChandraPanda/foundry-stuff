# APIM connection details
APIM_SUBSCRIPTION_KEY="----------------"
# Header name for the APIM subscription key; in some cases, it can be `api-key` or `Ocp-Apim-Subscription-Key`
APIM_SUBSCRIPTION_KEY_HEADER="api-key"
# APIM API base URI
APIM_API_URL="https://{YOUR_APIM_INSTANCE_NAME}.azure-api.net/{API_SUFFIX}"
# Timeout for API requests
API_TIMEOUT_SECONDS="120"
# Model for the APIM gateway connection, e.g. `gpt-4o`
APIM_MODEL="gpt-4o"
# Project endpoint for the AI Project
PROJECT_ENDPOINT="https://{FOUNDRY_ACCOUNT_NAME}.services.ai.azure.com/api/projects/{FOUNDRY_PROJECT_NAME}"
# BYOM model name as foundry admin connected model
BYOM_MODEL="{APIM_API_NAME}/{BYOM_MODEL_NAME}"
# Foundry prompt agent name
PROMPT_AGENT_NAME="byom-gateway-agent"


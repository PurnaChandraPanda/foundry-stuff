# Tenant of the subscription containing the Foundry resource.
AZURE_TENANT_ID=""

# Full project ARM resource ID for the on-demand connection script, not the endpoint.
AZURE_AI_PROJECT_ID="/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>"
AZURE_AI_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="<model-deployment-name>"

# Private APIM endpoint. Needed for toolbox creation, not for consumption.
APIM_MCP_URL="https://<private-apim-host>/<api-suffix>/mcp"
APIM_MCP_SERVER_LABEL="private-apim"
APIM_MCP_CONNECTION_NAME="private-route-apim-mcp"
APIM_ALLOWED_TOOLS=""

# Used only by ../create_mcp_connection.sh toolbox-mcp-private, not by agent consumers.
APIM_SUBSCRIPTION_KEY_HEADER="Ocp-Apim-Subscription-Key"
APIM_SUBSCRIPTION_KEY=""

APIM_TOOLBOX_NAME="private-apim-toolbox"
MCP_TIMEOUT_SECONDS="120"

# Prompt agent -> toolbox, separate from the downstream APIM-key connection.
APIM_TOOLBOX_CONNECTION_NAME="private-apim-toolbox-mcp"
APIM_PROMPT_AGENT_NAME="private-apim-toolbox-prompt"


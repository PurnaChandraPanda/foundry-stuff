# Existing project ARM resource ID for azd initialization, not read by the agent.
AZURE_AI_PROJECT_ID="/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>"
AZURE_AI_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="<model-deployment-name>"

# Direct MCP gateway configuration.
APIM_MCP_URL="https://<private-apim-host>/<api-suffix>/mcp"
APIM_MCP_SERVER_LABEL="private-apim"

# Credentials are read from this connection at startup, not deployed as plaintext.
APIM_MCP_CONNECTION_NAME="private-route-apim-mcp"
APIM_ALLOWED_TOOLS=""

# Change only after reviewing the allowlist and effective backend permissions.
APIM_ALLOW_UNATTENDED="true"
MCP_TIMEOUT_SECONDS="120"
PORT="8088"


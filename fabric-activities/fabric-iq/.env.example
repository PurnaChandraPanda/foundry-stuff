# Tenant and subscription information for Azure resources
TENANT_ID="..."
SUBSCRIPTION_ID="..."

# Foundry project ARM id till project level
AZURE_AI_PROJECT_ID="/subscriptions/---------/resourceGroups/{resource-group}/providers/Microsoft.CognitiveServices/accounts/{foundry-account}/projects/{project_name}"

# Foundry project and model information
AZURE_AI_PROJECT_ENDPOINT="https://<resource>.ai.azure.com/api/projects/<project_name>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5.4-mini"
FABRIC_IQ_AGENT_NAME="MyFabricIQAgent"

# Fabric IQ project connection (RemoteTool + UserEntraToken).
# Name allows alphanumerics, dashes and dots only - no underscores.
FABRIC_IQ_CONNECTION_NAME="fabric-iq-dataagent"

# Short lowercase label shown in tool-approval prompts
FABRIC_IQ_SERVER_LABEL="fabriciq-dataagent"

# Fabric IQ item type. Decides the shape of the MCP endpoint URL, which is
# constructed in code from the GUIDs below:
#   dataagent      -> /v1/mcp/workspaces/{ws}/dataagents/{item}/agent
#   ontology       -> /v1/mcp/dataPlane/workspaces/{ws}/items/{item}/ontologyEndpoint
#   semanticmodel  -> /v1/mcp/fabricaihub/integrations/m365   (no GUIDs used)
FABRIC_IQ_ITEM_TYPE="dataagent"

# Fabric workspace and item identifiers, read from the Fabric portal URL.
FABRIC_WORKSPACE_ID=...
FABRIC_ARTIFACT_ID=...

# Optional escape hatch. Leave empty to use the URL built from the values above;
# set it to force an endpoint this sample does not know how to construct.
# FABRIC_IQ_SERVER_URL=""

# Audience the connection requests its delegated token for
FABRIC_IQ_AUDIENCE="https://api.fabric.microsoft.com"

# Toolbox used by the local agent sample
FABRIC_IQ_TOOLBOX_NAME="fabric-iq-toolbox"

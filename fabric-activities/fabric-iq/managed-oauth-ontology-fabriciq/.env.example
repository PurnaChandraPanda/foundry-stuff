# Tenant and subscription information for Azure resources
TENANT_ID="..."
SUBSCRIPTION_ID="..."

# Foundry project ARM id till project level
AZURE_AI_PROJECT_ID="/subscriptions/---------/resourceGroups/{resource-group}/providers/Microsoft.CognitiveServices/accounts/{foundry-account}/projects/{project_name}"

# Foundry project and model information
AZURE_AI_PROJECT_ENDPOINT="https://<resource>.ai.azure.com/api/projects/<project_name>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5.4-mini"
FABRIC_IQ_AGENT_NAME="MyFabricIQManagedOAuthOntologyAgent"

# Create a Fabric IQ managed-user connection matching portal reference daontology1.
# The saved ARM authType is UserEntraToken, not OAuth2.
# Name allows alphanumerics, dashes and dots only - no underscores.
FABRIC_IQ_CONNECTION_NAME="fabric-iq-managed-oauth-ontology"

# Short lowercase label shown in tool-approval prompts
FABRIC_IQ_SERVER_LABEL="fabriciq-managed-oauth-ontology"

# Direct-client comparison only; does not filter tools exposed by the toolbox.
# Use the unprefixed tool names advertised by the direct Fabric endpoint.
# Unset to expose all discovered tools; [] exposes none and the local agent stops.
# Direct-client comparison only: unprefixed tool names from the Fabric endpoint.
# ALLOWED_TOOLS='["fabriciq-managed-oauth-ontology___list_ontology_entities","fabriciq-managed-oauth-ontology___list_ontology_rules"]'
ALLOWED_TOOLS='["list_ontology_rules","list_ontology_entities"]'

# Fabric IQ item type. Decides the shape of the MCP endpoint URL, which is
# constructed in code from the GUIDs below:
#   dataagent      -> /v1/mcp/workspaces/{ws}/dataagents/{item}/agent
#   ontology       -> /v1/mcp/dataPlane/workspaces/{ws}/items/{item}/ontologyEndpoint
#   semanticmodel  -> /v1/mcp/fabricaihub/integrations/m365   (no GUIDs used)
FABRIC_IQ_ITEM_TYPE="ontology"

# Fabric workspace and item identifiers, read from the Fabric portal URL.
FABRIC_WORKSPACE_ID=...
FABRIC_ARTIFACT_ID=...

# The script uses the verified Fabric API audience and metadata.type=fabric_iq_preview.
# No connector name, client secret, or manually supplied token is needed.

# Toolbox used by the local agent sample
FABRIC_IQ_TOOLBOX_NAME="fabric-iq-managed-oauth-toolbox"

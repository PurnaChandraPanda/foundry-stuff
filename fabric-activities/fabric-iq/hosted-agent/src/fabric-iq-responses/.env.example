# Tenant and subscription information for Azure resources
TENANT_ID="..."
SUBSCRIPTION_ID="..."

# Foundry project ARM id till project level
AZURE_AI_PROJECT_ID="/subscriptions/{}/resourceGroups/{}/providers/Microsoft.CognitiveServices/accounts/{}/projects/{}"

# Foundry project endpoint
AZURE_AI_PROJECT_ENDPOINT="https://{foundry-account-name}.services.ai.azure.com/api/projects/{project-name}"

# Model deployment name in foundry
AZURE_AI_MODEL_DEPLOYMENT_NAME="{deployment-name}"

# Toolbox holding the Fabric IQ tool. Publish it with create_fabric_iq_toolbox.py
# in the parent sample; this agent attaches its latest version at startup.
FABRIC_IQ_TOOLBOX_NAME="fabric-iq-toolbox"
